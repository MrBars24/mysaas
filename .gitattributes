# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicitly ensure binary files are left untouched
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Prevent shell scripts from using CRLF
*.sh text eol=lf